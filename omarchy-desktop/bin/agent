#!/usr/bin/env bash
# ==============================================================================
# agent - Lanzador de Agentes Autónomos de IA estilo Omarchy
# ==============================================================================
# Omarchy integra atajos globales para abrir agentes de código (Super + C o 'c').
# Este script detecta y lanza tu agente preferido (Antigravity, Claude Code, OpenCode).
# ==============================================================================
set -euo pipefail

PROMPT="${*:-}"
WORK_DIR="${PWD}"

# Si se lanza en el $HOME, prefiere la carpeta de Proyectos/Work
if [ "$WORK_DIR" = "$HOME" ]; then
    if [ -d "$HOME/Work" ]; then
        cd "$HOME/Work"
    elif [ -d "$HOME/Projects" ]; then
        cd "$HOME/Projects"
    elif [ -d "$HOME/Desarrollo" ]; then
        cd "$HOME/Desarrollo"
    fi
fi

# Detectar agentes disponibles en orden de preferencia
if command -v antigravity >/dev/null 2>&1; then
    echo "[+] Iniciando Google Antigravity en $(pwd)..."
    if [ -n "$PROMPT" ]; then
        antigravity "$PWD" --prompt "$PROMPT" 2>/dev/null || antigravity "$PWD"
    else
        antigravity "$PWD"
    fi
elif command -v claude >/dev/null 2>&1; then
    echo "[+] Iniciando Claude Code en $(pwd)..."
    if [ -n "$PROMPT" ]; then
        claude "$PROMPT"
    else
        claude
    fi
elif command -v opencode >/dev/null 2>&1; then
    echo "[+] Iniciando OpenCode..."
    opencode
elif command -v grok-bot >/dev/null 2>&1 || [ -f "${HOME}/.local/share/grok-bot/appimage" ]; then
    echo "[+] Iniciando Grok Bot..."
    "${HOME}/.local/share/grok-bot/appimage" &
else
    echo "=========================================================="
    echo "       Modo de Agentes estilo Omarchy                     "
    echo "=========================================================="
    echo "No se encontró un agente configurado en la ruta."
    echo "Instala o activa tu agente preferido:"
    echo "  - Antigravity: ./setup.sh --antigravity"
    echo "  - Claude Code: npm install -g @anthropic-ai/claude-code"
    echo "  - Grok Bot: ./setup.sh --grokbot"
    echo "=========================================================="
fi
