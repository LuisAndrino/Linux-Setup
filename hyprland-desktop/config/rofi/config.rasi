configuration {
    modi: "drun,run,window";
    lines: 7;
    columns: 2;
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "alacritty";
    drun-match-fields: "name,generic,exec,categories,keywords";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Buscar Apps: ";
    display-run: "   Comando: ";
    display-window: "   Ventanas: ";
}

@import "theme.rasi"

window {
    height: 400px;
    width: 650px;
    border: 2px;
    border-color: @accent-col;
    border-radius: 12px;
    background-color: @bg-col;
    padding: 20px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    children: [prompt,entry];
    background-color: transparent;
    border-radius: 8px;
    padding: 2px;
    margin: 0 0 15px 0;
}

prompt {
    background-color: transparent;
    padding: 6px;
    text-color: @accent-col;
    border-radius: 6px;
    margin: 0 0 0 0;
}

entry {
    padding: 6px;
    margin: 0 0 0 10px;
    text-color: @fg-col;
    background-color: transparent;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 2px;
    columns: 2;
    lines: 6;
    background-color: transparent;
}

element {
    padding: 8px;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    margin: 0 0 0 8px;
}

element selected {
    background-color: @selected-col;
    text-color: @accent-col;
}
