#!/usr/bin/env bash
# ==============================================================================
# hypr-theme - Conmutador e instalador dinámico de temas para Hyprland
# ==============================================================================
# Soporta tanto paletas nativas (.conf) como los temas oficiales y de la
# comunidad de Omarchy (carpetas con colors.toml y backgrounds).
# ==============================================================================
set -euo pipefail

THEMES_DIR="${HOME}/.config/hypr/themes"
CURRENT_THEME_FILE="${HOME}/.config/hypr/current_theme"

mkdir -p "${THEMES_DIR}" \
         "${HOME}/.config/hypr" \
         "${HOME}/.config/waybar" \
         "${HOME}/.config/rofi" \
         "${HOME}/.config/alacritty"

# -----------------------------------------------------------------------------
# Parser para colors.toml (formato nativo de temas Omarchy)
# -----------------------------------------------------------------------------
parse_toml_color() {
    local file="$1"
    local key="$2"
    local default_val="$3"

    local val
    val=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "${file}" 2>/dev/null | head -n1 | sed -E 's/.*=[[:space:]]*"([^"]+)".*/\1/' || true)
    if [ -n "${val}" ]; then
        echo "${val}"
    else
        echo "${default_val}"
    fi
}

list_themes() {
    echo "=========================================================="
    echo "          Temas disponibles para Hyprland                 "
    echo "=========================================================="
    local curr
    curr=$(get_current_theme)

    # 1. Temas en formato carpeta (estilo Omarchy con colors.toml)
    find "${THEMES_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | while read -r dir; do
        local name
        name=$(basename "${dir}")
        if [ "${name}" = "${curr}" ]; then
            echo "  * ${name} (activo - formato Omarchy)"
        else
            echo "    ${name} (Omarchy)"
        fi
    done

    # 2. Temas clásicos en archivo .conf
    find "${THEMES_DIR}" -maxdepth 1 -name "*.conf" 2>/dev/null | sort | while read -r f; do
        local name
        name=$(basename "${f}" .conf)
        if [ "${name}" = "${curr}" ]; then
            echo "  * ${name} (activo - conf)"
        else
            echo "    ${name}"
        fi
    done
    echo "=========================================================="
    echo "Comandos:"
    echo "  hypr-theme next              -> Cambiar al siguiente tema"
    echo "  hypr-theme <nombre>          -> Aplicar tema específico"
    echo "  hypr-theme install <git-url> -> Instalar tema de Omarchy desde GitHub"
}

get_current_theme() {
    if [ -f "${CURRENT_THEME_FILE}" ]; then
        cat "${CURRENT_THEME_FILE}"
    else
        echo "tokyo-night"
    fi
}

apply_theme() {
    local target="$1"
    local theme_dir="${THEMES_DIR}/${target}"
    local theme_conf="${THEMES_DIR}/${target}.conf"

    local BG FG ACCENT ACCENT_SEC MUTED URGENT BORDER_ACTIVE BORDER_INACTIVE
    local WAYBAR_BG ROFI_BG ROFI_FG ROFI_ACCENT
    local WALLPAPER=""

    if [ -d "${theme_dir}" ] && [ -f "${theme_dir}/colors.toml" ]; then
        # Cargar tema formato Omarchy
        local toml="${theme_dir}/colors.toml"
        ACCENT=$(parse_toml_color "${toml}" "accent" "#7aa2f7")
        BG=$(parse_toml_color "${toml}" "background" "#1a1b26")
        FG=$(parse_toml_color "${toml}" "foreground" "#c0caf5")
        MUTED=$(parse_toml_color "${toml}" "muted" "#414868")
        URGENT=$(parse_toml_color "${toml}" "red" "#f7768e")
        ACCENT_SEC=$(parse_toml_color "${toml}" "blue" "${ACCENT}")

        # Quitar '#' inicial si existe para hyprland rgb(...)
        local ACC_HEX="${ACCENT#\#}"
        local SEC_HEX="${ACCENT_SEC#\#}"
        local MUT_HEX="${MUTED#\#}"

        BORDER_ACTIVE="${ACC_HEX}"
        BORDER_INACTIVE="${MUT_HEX}"
        WAYBAR_BG="rgba($(printf "%d, %d, %d" "0x${BG:1:2}" "0x${BG:3:2}" "0x${BG:5:2}"), 0.85)"
        ROFI_BG="${BG}"
        ROFI_FG="${FG}"
        ROFI_ACCENT="${ACCENT}"

        # Buscar fondo de pantalla en la carpeta del tema Omarchy
        if [ -d "${theme_dir}/backgrounds" ]; then
            WALLPAPER=$(find "${theme_dir}/backgrounds" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | head -n1 || true)
        fi
        if [ -z "${WALLPAPER}" ]; then
            WALLPAPER=$(find "${theme_dir}" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | head -n1 || true)
        fi

    elif [ -f "${theme_conf}" ]; then
        # Cargar tema formato .conf clásico
        # shellcheck source=/dev/null
        . "${theme_conf}"
    else
        echo "[!] Tema '${target}' no encontrado en ${THEMES_DIR}"
        list_themes
        exit 1
    fi

    echo "[+] Aplicando tema '${target}'..."

    # 1. Configuración de colores para Hyprland
    cat << EOF > "${HOME}/.config/hypr/theme.conf"
# Tema generado automáticamente: ${target}
general {
    col.active_border = rgb(${BORDER_ACTIVE})
    col.inactive_border = rgb(${BORDER_INACTIVE})
}
EOF

    # 2. Configuración de colores para Waybar
    cat << EOF > "${HOME}/.config/waybar/theme.css"
/* Tema generado automáticamente: ${target} */
@define-color bg ${WAYBAR_BG};
@define-color fg ${FG};
@define-color accent ${ACCENT};
@define-color accent_alt ${ACCENT_SEC};
@define-color muted ${MUTED};
@define-color urgent ${URGENT};
EOF

    # 3. Configuración de colores para Rofi
    cat << EOF > "${HOME}/.config/rofi/theme.rasi"
/* Tema generado automáticamente: ${target} */
* {
    bg-col: ${ROFI_BG};
    fg-col: ${ROFI_FG};
    accent-col: ${ROFI_ACCENT};
    selected-col: ${ROFI_ACCENT}33;
}
EOF

    # 4. Configuración de colores para Alacritty
    cat << EOF > "${HOME}/.config/alacritty/theme.toml"
# Tema generado automáticamente: ${target}
[colors.primary]
background = "${BG}"
foreground = "${FG}"

[colors.cursor]
text = "${BG}"
cursor = "${ACCENT}"

[colors.normal]
black   = "${BG}"
red     = "${URGENT}"
green   = "${ACCENT_SEC}"
yellow  = "${ACCENT}"
blue    = "${ACCENT}"
magenta = "${ACCENT_SEC}"
cyan    = "${ACCENT}"
white   = "${FG}"
EOF

    # 5. Cambiar fondo con swaybg si hay uno disponible en el tema
    if [ -n "${WALLPAPER}" ] && command -v swaybg >/dev/null 2>&1; then
        pkill -x swaybg 2>/dev/null || true
        swaybg -i "${WALLPAPER}" -m fill >/dev/null 2>&1 &
        echo "${WALLPAPER}" > "${HOME}/.config/hypr/current_wallpaper"
    fi

    echo "${target}" > "${CURRENT_THEME_FILE}"

    # Recargar Hyprland y Waybar en caliente si están corriendo
    if command -v hyprctl >/dev/null 2>&1 && pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi

    if pgrep -x waybar >/dev/null 2>&1; then
        pkill -SIGUSR2 -x waybar 2>/dev/null || true
    fi

    echo "[✓] Tema '${target}' aplicado con éxito en Hyprland, Waybar, Alacritty y Rofi."
}

install_theme() {
    local repo_url="${1:-}"
    if [ -z "${repo_url}" ]; then
        echo "Uso: hypr-theme install <git-url>"
        echo "Ejemplo: hypr-theme install https://github.com/omacom/omarchy.git"
        exit 1
    fi

    local theme_name
    theme_name=$(basename "${repo_url}" .git | sed -E 's/^omarchy-//; s/-theme$//' | tr '[:upper:]' '[:lower:]')
    local dest="${THEMES_DIR}/${theme_name}"

    echo "[+] Descargando tema desde ${repo_url}..."
    rm -rf "${dest}"
    if git clone --depth 1 "${repo_url}" "${dest}"; then
        echo "[✓] Tema clonado en ${dest}"
        apply_theme "${theme_name}"
    else
        echo "[!] Error clonando el repositorio del tema."
        exit 1
    fi
}

ACTION="${1:-next}"

case "$ACTION" in
    list)
        list_themes
        ;;
    next)
        current=$(get_current_theme)
        # Obtener lista de todos los nombres disponibles
        mapfile -t ALL_THEMES < <(
            find "${THEMES_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | xargs -n1 basename 2>/dev/null
            find "${THEMES_DIR}" -maxdepth 1 -name "*.conf" 2>/dev/null | sed 's/\.conf$//' | xargs -n1 basename 2>/dev/null
        )
        if [ ${#ALL_THEMES[@]} -eq 0 ]; then
            ALL_THEMES=("tokyo-night" "catppuccin" "nord" "gruvbox")
        fi

        next_theme="${ALL_THEMES[0]}"
        for i in "${!ALL_THEMES[@]}"; do
            if [ "${ALL_THEMES[$i]}" = "$current" ]; then
                next_idx=$(( (i + 1) % ${#ALL_THEMES[@]} ))
                next_theme="${ALL_THEMES[$next_idx]}"
                break
            fi
        done
        apply_theme "$next_theme"
        ;;
    install)
        shift
        install_theme "${1:-}"
        ;;
    *)
        apply_theme "$ACTION"
        ;;
esac
